# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing stateless access and refresh tokens.
JWT_SECRET="change_me_in_production_super_secret_key"

# DB_PATH: Local persistent SQLite database path (for standalone mode).
DB_PATH="./data/scolarite.db"

# Payment Gateway API Configuration (sandbox | cinetpay | stripe)
PAYMENT_PROVIDER="sandbox"
PAYMENT_WEBHOOK_SECRET="change_me_payment_hmac_secret"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
STRIPE_SECRET_KEY=""

# PostgreSQL HA Cluster Configuration (Projet 6 - HAProxy VIP / Patroni)
PG_HOST="192.168.56.100"
PG_PORT="5000"
PG_DATABASE="scolarite"
PG_USER="app"
PG_PASSWORD="motdepasse_app"
